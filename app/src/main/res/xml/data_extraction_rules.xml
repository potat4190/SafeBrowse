<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ reads this instead of backup_rules.xml, and allowBackup="false"
     does not stop device-to-device transfer on its own. Same intent: nothing
     leaves the device, and nothing can be restored to roll the list back. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
