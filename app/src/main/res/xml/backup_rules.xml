<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up. The blocklist staying on-device is the point, and
     a cloud restore would be a way to roll the list back. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
